{
	"name": "n8n-nodes-amazon-selling-partner-marketplace",
	"version": "0.0.23",
	"description": "n8n community node for the Amazon Selling Partner API",
	"license": "MIT",
	"homepage": "",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "Jan Stoll (DNAngelX)",
		"email": "stolly82@gmail.com",
		"url": "https://github.com/DNAngelX"
	},
	"repository": {
		"type": "git",
		"url": "git+https://gitlab.com/stolly82/n8n-nodes-amazonsellingpartner.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"generate:spapi": "node scripts/generate-spapi.js",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/AmazonSpApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/AmazonSellingPartner/AmazonSellingPartner.node.js"
		]
	},
	"dependencies": {
		"aws4": "^1.12.0",
		"axios": "^1.6.8",
		"csv-parse": "^6.1.0"
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"@types/aws4": "^1.11.6",
		"@types/csv-parse": "^1.1.12",
		"@types/node": "^20.11.30",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"overrides": {
		"change-case": "4.1.2"
	}
}
